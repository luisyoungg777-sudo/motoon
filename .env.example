# Copie para .env e preencha apenas o que for usar.
# NADA aqui e obrigatorio: o Motoon funciona 100% offline e sem login.

# --- Fase 4: sincronizacao na nuvem (Supabase) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Integracao 9.1: leitura de nota por IA (DESLIGADA) ---
